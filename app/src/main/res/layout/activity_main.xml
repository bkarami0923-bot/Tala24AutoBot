<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Status:"
            android:textSize="18sp"
            android:padding="8dp" />

        <EditText
            android:id="@+id/edtToken"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Bot Token"
            android:padding="10dp" />

        <EditText
            android:id="@+id/edtChatId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Chat ID"
            android:padding="10dp" />

        <!-- ساعت و دقیقه در دو کادر جدا -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            android:paddingTop="10dp">

            <EditText
                android:id="@+id/edtHour"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="HH"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="2"
                android:padding="10dp" />

            <EditText
                android:id="@+id/edtMinute"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="MM"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="2"
                android:padding="10dp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnSaveSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save Settings"
            android:padding="12dp"
            android:layout_marginTop="12dp" />

        <Button
            android:id="@+id/btnSendOnce"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Extract Prices and Send"
            android:padding="12dp"
            android:layout_marginTop="12dp" />

        <Button
            android:id="@+id/btnStartAuto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Send at Scheduled Time"
            android:padding="12dp"
            android:layout_marginTop="12dp" />

        <TextView
            android:id="@+id/txtLastMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Last Sent Message"
            android:textSize="16sp"
            android:padding="12dp"
            android:layout_marginTop="20dp" />

    </LinearLayout>
</ScrollView>
